{
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": { "onSave": true, "forwardSearchAfter": true },
          "forwardSearch": {
            "executable": "direnv",
            "args": [
              "exec",
              ".",
              "evince-synctex",
              "-f",
              "%l",
              "%p",
              "zed %f:%l",
            ],
          },
        },
      },
    },
  },
  "languages": {
    "Markdown": {
      "format_on_save": "on",
      "preferred_line_length": 80,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--parser",
            "markdown",
            "--prose-wrap",
            "always",
            "--print-width",
            "80",
          ],
        },
      },
    },
  },
}
